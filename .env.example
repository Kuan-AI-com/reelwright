# Copy to .env and fill in. Never commit .env.

# Web studio login (required on a server).
REELWRIGHT_PASSWORD=

# Script writer (optional). Without it you write scripts yourself.
# anthropic | openai | openrouter | ollama | none
LLM_PROVIDER=none
# anthropic default: claude-opus-5-5 · openai default: gpt-4o-mini · openrouter: required
LLM_MODEL=
LLM_API_KEY=
# Only for ollama / any OpenAI-compatible server
LLM_BASE_URL=

# draft | looks | delivery
RENDER_QUALITY=looks
RENDER_FPS=30

# estimate (instant) | whisper (accurate word timing, slower)
CAPTIONS_ALIGN=estimate

# Keep the on-screen "AI-generated" label and metadata. Read docs/legal.md before disabling.
AI_DISCLOSURE=true

# Only for docker-compose.https.yml
DOMAIN=
